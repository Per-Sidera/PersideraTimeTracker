<Window x:Class="PersideraTimeTracker.Views.MercurySetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect Mercury Invoicing" Height="500" Width="480"
        WindowStyle="None" AllowsTransparency="False"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#191919" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#1F1F1F" MouseLeftButtonDown="TitleBar_Drag">
            <TextBlock Text="WELCOME" Foreground="#9A9A9A" FontSize="11" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="16,0"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18">
                <TextBlock Text="Connect Mercury Invoicing" Foreground="#F1F1F1" FontSize="20"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Set up once to auto-create invoices at billing periods."
                           Foreground="#9A9A9A" FontSize="12" Margin="0,4,0,18"/>

                <TextBlock Text="Hourly Rate ($/hr)" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="HourlyRate" Width="160" HorizontalAlignment="Left" Margin="0,4,0,14"/>

                <TextBlock Text="Mercury API Token" Style="{StaticResource LabelText}"/>
                <PasswordBox x:Name="ApiToken" Margin="0,4,0,14"/>

                <TextBlock Text="Mercury Customer ID" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="CustomerId" Margin="0,4,0,14"/>

                <TextBlock Text="Mercury Destination Account ID" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="DestinationAccountId" Margin="0,4,0,14"/>

                <CheckBox x:Name="AchDebit" Content="Enable ACH debit on invoices" IsChecked="True" Margin="0,0,0,6"/>
                <CheckBox x:Name="CreditCard" Content="Enable credit card on invoices" Margin="0,0,0,4"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Background="#1F1F1F">
            <Border BorderBrush="#2A2A2A" BorderThickness="0,1,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,16,0">
                <Button Content="Skip for now" Padding="14,6" Margin="0,0,8,0" Click="Skip_Click"/>
                <Button Content="Save &amp; Continue" Padding="18,6" Style="{StaticResource EmberButton}"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
