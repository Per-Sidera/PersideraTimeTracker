<Window x:Class="PersideraTimeTracker.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="520" Width="460"
        WindowStyle="None" AllowsTransparency="False"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#191919" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="#1F1F1F" MouseLeftButtonDown="TitleBar_Drag">
            <TextBlock Text="SETTINGS" Foreground="#9A9A9A" FontSize="11" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="16,0"/>
            <Button Content="&#10005;" Style="{StaticResource CloseButton}" Width="44" Height="32"
                    HorizontalAlignment="Right" Click="Close_Click"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16">
                <TextBlock Text="Billing" Foreground="#F1F1F1" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>

                <TextBlock Text="Hourly Rate ($/hr)" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="HourlyRate" Width="160" HorizontalAlignment="Left" Margin="0,4,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Billing Day 1 (1-28)" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="BillingDay1" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Billing Day 2 (1-28)" Style="{StaticResource LabelText}"/>
                        <TextBox x:Name="BillingDay2" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Mercury Invoicing" Foreground="#F1F1F1" FontSize="15" FontWeight="SemiBold"
                           Margin="0,8,0,10"/>

                <TextBlock Text="Mercury Customer ID" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="CustomerId" Margin="0,4,0,12"/>

                <TextBlock Text="Mercury Destination Account ID" Style="{StaticResource LabelText}"/>
                <TextBox x:Name="DestinationAccountId" Margin="0,4,0,12"/>

                <CheckBox x:Name="AchDebit" Content="Enable ACH debit on invoices" Margin="0,0,0,6"/>
                <CheckBox x:Name="CreditCard" Content="Enable credit card on invoices" Margin="0,0,0,12"/>

                <TextBlock Text="Mercury API Token" Style="{StaticResource LabelText}"/>
                <Grid Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="ApiToken" Grid.Column="0" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="Save Token" Padding="12,6" Click="SaveToken_Click"/>
                </Grid>
                <TextBlock x:Name="TokenStatus" FontSize="12" Foreground="#6A6A6A" Margin="0,2,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Grid Grid.Row="2" Background="#1F1F1F">
            <Border BorderBrush="#2A2A2A" BorderThickness="0,1,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,16,0">
                <Button Content="Cancel" Padding="16,6" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Save" Padding="20,6" Style="{StaticResource EmberButton}" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
