<Window x:Class="PersideraTimeTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PersideraTimeTracker.Views"
        Title="Persidera Time Tracker"
        Height="720" Width="900" MinHeight="480" MinWidth="700"
        WindowStyle="None" AllowsTransparency="False"
        WindowStartupLocation="CenterScreen"
        Background="#191919" Icon="Assets/clock.ico"
        FontFamily="Segoe UI">

    <Window.Resources>
        <conv:CategoryColorConverter x:Key="CategoryColor"/>
        <conv:BillableBrushConverter x:Key="BillableBrush"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <!-- ========== Title bar ========== -->
        <Grid Grid.Row="0" Background="#1F1F1F" MouseLeftButtonDown="TitleBar_Drag">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                <TextBlock Text="&#9685;" Foreground="#FF6A1F" FontSize="14"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="PERSIDERA TIME TRACKER" Foreground="#9A9A9A"
                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextOptions.TextFormattingMode="Display"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="&#9881;" Style="{StaticResource IconButton}" Width="44" Height="32"
                        ToolTip="Settings" Command="{Binding OpenSettingsCommand}"/>
                <Button Content="&#8211;" Style="{StaticResource IconButton}" Width="44" Height="32"
                        Click="Minimize_Click" ToolTip="Minimize"/>
                <Button Content="&#9633;" Style="{StaticResource IconButton}" Width="44" Height="32"
                        Click="Maximize_Click" ToolTip="Maximize"/>
                <Button Content="&#10005;" Style="{StaticResource CloseButton}" Width="44" Height="32"
                        Click="Close_Click" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- ========== Entry input bar ========== -->
        <Grid Grid.Row="1" Background="#1F1F1F">
            <Border BorderBrush="#2A2A2A" BorderThickness="0,0,0,1"/>
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBox x:Name="DescBox" Height="36"
                             Text="{Binding NewEntryDescription, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="What did you work on?" Foreground="#6A6A6A" FontSize="13"
                               Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=DescBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ComboBox Grid.Column="1" Height="36" VerticalAlignment="Center" Margin="0,0,8,0"
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding SelectedCategory}"/>

                <ToggleButton Grid.Column="2" Height="36" Width="36" VerticalAlignment="Center"
                              Margin="0,0,8,0" IsChecked="{Binding NewEntryBillable}"
                              ToolTip="Billable">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="b" Background="#1F1F1F" BorderBrush="#2A2A2A"
                                    BorderThickness="1" CornerRadius="4">
                                <TextBlock x:Name="t" Text="$" FontSize="16" FontWeight="Bold"
                                           Foreground="#6A6A6A" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="t" Property="Foreground" Value="#F2DC14"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#252525"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <!-- ADD / STOP -->
                <Button Grid.Column="3" Height="36" VerticalAlignment="Center"
                        Command="{Binding AddEntryCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource EmberButton}">
                            <Setter Property="Content" Value="&#9654;  ADD"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTracking}" Value="True">
                                    <Setter Property="Content" Value="&#9632;  STOP"/>
                                    <Setter Property="Background" Value="#EF1625"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#FF3340"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Live timer overlay when tracking -->
            <TextBlock Text="{Binding RunningTimerDisplay}" FontFamily="Consolas" FontSize="13"
                       Foreground="#F2DC14" VerticalAlignment="Top" HorizontalAlignment="Right"
                       Margin="0,1,164,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTracking}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- ========== Entries list ========== -->
        <ScrollViewer Grid.Row="2" Background="#191919" VerticalScrollBarVisibility="Auto"
                      Padding="0,0,0,12">
            <ItemsControl ItemsSource="{Binding GroupedEntries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <!-- Date header -->
                            <Grid Margin="16,16,16,4">
                                <TextBlock Text="{Binding DateDisplay}" Foreground="#9A9A9A" FontSize="12"
                                           FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Total: " Foreground="#6A6A6A" FontSize="12"/>
                                    <TextBlock Text="{Binding TotalDisplay}" Foreground="#6A6A6A"
                                               FontFamily="Consolas" FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <!-- Entry rows -->
                            <ItemsControl ItemsSource="{Binding}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="row" Background="#1F1F1F" Margin="16,1" CornerRadius="4">
                                            <Grid Height="48" Margin="12,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Description -->
                                                <TextBlock Grid.Column="0" Text="{Binding Description}"
                                                           Foreground="#F1F1F1" FontSize="13"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,12,0"/>

                                                <!-- Category dot + name -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                            VerticalAlignment="Center" Margin="8,0">
                                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                             Fill="{Binding Category, Converter={StaticResource CategoryColor}}"/>
                                                    <TextBlock Text="{Binding Category}" Foreground="#9A9A9A"
                                                               FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                </StackPanel>

                                                <!-- Billable $ -->
                                                <TextBlock Grid.Column="2" Text="$" FontWeight="Bold" FontSize="14"
                                                           Foreground="{Binding IsBillable, Converter={StaticResource BillableBrush}}"
                                                           VerticalAlignment="Center" Margin="8,0"/>

                                                <!-- Time range -->
                                                <TextBlock Grid.Column="3" Text="{Binding TimeRangeDisplay}"
                                                           Foreground="#9A9A9A" FontSize="12"
                                                           VerticalAlignment="Center" Margin="8,0"/>

                                                <!-- Duration -->
                                                <TextBlock Grid.Column="4" Text="{Binding DurationDisplay}"
                                                           Foreground="#F1F1F1" FontFamily="Consolas" FontSize="13"
                                                           VerticalAlignment="Center" Margin="12,0,4,0"
                                                           MinWidth="68" TextAlignment="Right"/>

                                                <!-- Restart -->
                                                <Button Grid.Column="5" Content="&#9654;" Width="28" Height="28"
                                                        Style="{StaticResource IconButton}"
                                                        ToolTip="Start a new timer with this entry"
                                                        Command="{Binding DataContext.RestartTimerCommand,
                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>

                                                <!-- Context menu -->
                                                <Button Grid.Column="6" Content="&#8942;" Width="28" Height="28"
                                                        Style="{StaticResource IconButton}"
                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Click="RowMenu_Click">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Edit"
                                                                      Command="{Binding PlacementTarget.Tag.EditEntryCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding}"/>
                                                            <MenuItem Header="Delete"
                                                                      Command="{Binding PlacementTarget.Tag.DeleteEntryCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding}"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="row" Property="Background" Value="#252525"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ========== Status bar ========== -->
        <Grid Grid.Row="3" Background="#1F1F1F">
            <Border BorderBrush="#2A2A2A" BorderThickness="0,1,0,0"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <TextBlock Text="{Binding CurrentPeriodDisplay}" Foreground="#9A9A9A" FontSize="12"
                           VerticalAlignment="Center"/>
                <TextBlock Text="  |  " Foreground="#3A3A3A" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalHoursDisplay}" Foreground="#9A9A9A" FontSize="12"
                           VerticalAlignment="Center"/>
                <TextBlock Text="  |  " Foreground="#3A3A3A" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalValueDisplay}" Foreground="#F2DC14" FontSize="12"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Content="Create Invoice" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,12,0" Height="26" Padding="14,0"
                    Style="{StaticResource EmberButton}"
                    Command="{Binding CreateInvoiceCommand}"/>
        </Grid>
    </Grid>
</Window>
